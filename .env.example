# ── Deploy-in-a-Box environment ──────────────────────────────────────────────
# Copy to .env and fill in. Everything marked PLACEHOLDER must be replaced
# before going live. Nothing else in the codebase hides secrets.

# App
APP_URL=http://localhost:3000
# 32+ random bytes. Generate: openssl rand -base64 32
AUTH_SECRET=PLACEHOLDER_generate_with_openssl_rand_base64_32

# Postgres (app data — customers, deployments, logs; NOT customer AWS data)
DATABASE_URL=postgres://diab:diab@localhost:5432/diab

# Stripe — PLACEHOLDER test keys. Replace with your real keys.
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER
# Price IDs for the three plans (create Products/Prices in Stripe, paste IDs)
STRIPE_PRICE_STARTER=price_PLACEHOLDER_starter
STRIPE_PRICE_GROWTH=price_PLACEHOLDER_growth
STRIPE_PRICE_SCALE=price_PLACEHOLDER_scale

# Provisioning
# "mock"  — simulates a full provisioning run with realistic logs (no AWS calls).
#           Use for local dev and demos.
# "live"  — real STS AssumeRole + CloudFormation into the customer's account.
PROVISIONER_MODE=mock
# The AWS account ID this platform runs under. Customers grant this account
# assume-role access via the connector role. PLACEHOLDER — your AWS account ID.
PLATFORM_AWS_ACCOUNT_ID=000000000000
# Credentials the platform itself uses to call sts:AssumeRole in live mode.
# On EC2/ECS/Lambda leave these unset and use the instance/task role instead.
# PLACEHOLDER — only needed for live mode outside AWS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Job runner: shared secret for the /api/jobs/tick endpoint (cron driver).
# Generate: openssl rand -hex 24
CRON_SECRET=PLACEHOLDER_generate_with_openssl_rand_hex_24

# Admin seed (used once by `npm run seed:admin`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=PLACEHOLDER_change_me
ADMIN_NAME=Platform Admin

# Email. "console" logs emails to stdout (dev). "resend" sends via Resend API.
MAIL_TRANSPORT=console
RESEND_API_KEY=
MAIL_FROM=Deploy-in-a-Box <no-reply@example.com>

# Support
SUPPORT_EMAIL=support@example.com

# ── BYOC control plane (Phase 1: CI/CD) ──────────────────────────────────────
# 64 hex chars (openssl rand -hex 32) — encrypts customer environment variables.
# Set once; rotating requires re-sealing every stored value.
SECRETS_KEY=

# GitHub App for real deploys (leave empty to run git in simulation mode).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Force simulation even with credentials set: GIT_MODE=mock
GIT_MODE=
